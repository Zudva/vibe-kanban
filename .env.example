# Vibe Kanban Development Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================================================
# API KEY CONFIGURATION (Required for Z.ai & Claude Code)
# ============================================================================

# Your Anthropic or Z.ai API key
# Get it from: https://console.anthropic.com or https://z.ai/devpack
# Keep this private; do not commit to git
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your OpenAI-compatible API key (for Z.ai OpenAI mode)
# Same as ANTHROPIC_API_KEY if using Z.ai
OPENAI_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# API ENDPOINT CONFIGURATION (Optional - defaults included)
# ============================================================================

# Anthropic-compatible endpoint (for ZAI profile)
# Default: https://api.z.ai/api/anthropic (Z.ai)
# Change to https://api.anthropic.com if using native Anthropic
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# OpenAI-compatible endpoint (for ZAI_OPENAI profile)
# Default: https://api.z.ai/api/coding/paas/v4 (Z.ai)
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# OpenAI model name (for ZAI_OPENAI profile)
# Default: glm-4.7 (Z.ai GLM model)
OPENAI_MODEL=glm-4.7

# OpenAI context window (for ZAI_OPENAI profile)
# Default: 204800 (Z.ai GLM-4.7 context window)
OPENAI_CONTEXT_WINDOW=204800

# Disable image support in OpenAI-compatible mode (Z.ai)
# Set to "true" if your endpoint doesn't support images
OPENAI_DISABLE_IMAGES=true

# ============================================================================
# TIMEOUT CONFIGURATION (Optional)
# ============================================================================

# API request timeout in milliseconds
# Default: 3000000 (50 minutes) - suitable for long-running code generation
API_TIMEOUT_MS=3000000

# ============================================================================
# SERVER CONFIGURATION (Optional)
# ============================================================================

# Frontend port (auto-assigned if not set)
# FRONTEND_PORT=3000

# Backend port (auto-assigned if not set)
# BACKEND_PORT=5000

# Server host binding
# HOST=127.0.0.1

# ============================================================================
# REMOTE FEATURES (Optional)
# ============================================================================

# Base URL for remote API (if you have a remote deployment)
# Leave unset to disable remote features (default)
# VK_SHARED_API_BASE=https://api.example.com

# ============================================================================
# LOGGING (Optional)
# ============================================================================

# Rust log level (debug, info, warn, error)
# RUST_LOG=debug

# ============================================================================
# DEVELOPMENT FLAGS (Optional)
# ============================================================================

# Disable worktree orphan cleanup during dev
# DISABLE_WORKTREE_ORPHAN_CLEANUP=1

# ============================================================================
# NOTES
# ============================================================================
# 1. Rename this file to .env.local and fill in your API keys
# 2. The .env file in the repo contains safe defaults; .env.local overrides them
# 3. Never commit .env.local or your API keys to git
# 4. For Z.ai setup, run: npx @z_ai/coding-helper
# 5. API keys are stored locally in: ~/.local/share/vibe-kanban/api_key.json (Linux)
#                                   ~/Library/Application Support/vibe-kanban/api_key.json (macOS)
#                                   %APPDATA%\vibe-kanban\api_key.json (Windows)
